          "default": null,
          "description": "1-based call numbers of the target tool to affect; null means every call.",
          "title": "Apply On Calls"
        },
        "probability": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "type": {
          "const": "incorrect_output",
          "title": "Type",
          "type": "string"
        },
        "replacement_output": {
          "description": "Plausible but wrong content returned instead of the real result.",
          "minLength": 1,
          "title": "Replacement Output",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target_tool",
        "type",
        "replacement_output"
      ],
      "title": "IncorrectOutputFault",
      "type": "object"
    },
    "LatencyFault": {
      "additionalProperties": false,
