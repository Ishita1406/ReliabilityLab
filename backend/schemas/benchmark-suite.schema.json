          "title": "Type",
          "type": "string"
        },
        "injected_text": {
          "description": "Adversarial instructions appended to the tool output.",
          "minLength": 1,
          "title": "Injected Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target_tool",
        "type",
        "injected_text"
      ],
      "title": "PromptInjectionFault",
      "type": "object"
    },
    "RateLimitFault": {
