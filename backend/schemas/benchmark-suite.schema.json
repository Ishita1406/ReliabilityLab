        }
      },
      "required": [
        "id",
        "target_tool",
        "type",
        "malformation"
      ],
      "title": "MalformedOutputFault",
      "type": "object"
    },
    "MatchMode": {
      "enum": [
        "all",
        "any"
      ],
      "title": "MatchMode",
      "type": "string"
    },
    "PromptInjectionFault": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifier unique within its scenario.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.\\-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "target_tool": {
