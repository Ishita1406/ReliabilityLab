          "type": "string"
        },
        "target_tool": {
          "description": "Name of the tool whose calls are affected.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.\\-_][a-z0-9]+)*$",
          "title": "Target Tool",
          "type": "string"
        },
        "apply_on_calls": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "integer"
