          "title": "Probability",
          "type": "number"
        },
        "type": {
          "const": "latency",
          "title": "Type",
          "type": "string"
        },
        "delay_ms": {
          "exclusiveMinimum": 0,
          "title": "Delay Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "target_tool",
        "type",
        "delay_ms"
      ],
      "title": "LatencyFault",
      "type": "object"
    },
    "MalformationKind": {
      "description": "How a ``malformed_output`` fault corrupts a tool response.",
      "enum": [
        "truncated",
        "invalid_json",
        "wrong_schema"
      ],
      "title": "MalformationKind",
      "type": "string"
    },
    "MalformedOutputFault": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifier unique within its scenario.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.\\-_][a-z0-9]+)*$",
          "title": "Id",
