              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based call numbers of the target tool to affect; null means every call.",
          "title": "Apply On Calls"
        },
        "probability": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "type": {
          "const": "incomplete_result",
          "title": "Type",
          "type": "string"
        },
        "keep_fraction": {
          "description": "Fraction of the result (items or text) that is kept.",
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Keep Fraction",
          "type": "number"
        }
      },
      "required": [
        "id",
        "target_tool",
        "type",
        "keep_fraction"
      ],
      "title": "IncompleteResultFault",
      "type": "object"
    },
    "IncorrectOutputFault": {
      "additionalProperties": false,
      "properties": {
