# AI Reliability Lab environment template.
# Copy the relevant section into the app's own .env file; never commit real values.
# Unless noted, variables are optional; the defaults shown below are used if unset.

# --- Backend (copy to backend/.env) ------------------------------------------
# Name reported by GET /health.
APP_SERVICE_NAME=ai-reliability-lab-backend
# One of: development, test, production.
APP_ENVIRONMENT=development
# PostgreSQL connection (required for persistence, migrations, and database tests).
# The value below matches the LOCAL-ONLY defaults in infra/docker-compose.yml; it is not a
# real credential. Never put production credentials in this file.
APP_DATABASE_URL=postgresql+psycopg://reliabilitylab:reliabilitylab_local_dev@127.0.0.1:5433/reliabilitylab
# Trace events of runs older than this many days may be purged (see docs/engineering/05).
APP_TRACE_RETENTION_DAYS=30
# Celery broker (Redis is transient queue state only; PostgreSQL stays the source of truth).
APP_REDIS_URL=redis://127.0.0.1:6380/0
# Background execution (see docs/engineering/10). Defaults shown.
# APP_WORKER_CONCURRENCY=2
# APP_MAX_RUNNING_EXPERIMENTS=4
# APP_JOB_MAX_ATTEMPTS=3
# APP_JOB_RETRY_BACKOFF_SECONDS=5
# APP_JOB_LEASE_SECONDS=120
# APP_JOB_SOFT_TIME_LIMIT_SECONDS=3600
# APP_BROKER_VISIBILITY_TIMEOUT_SECONDS=7200
# Per-run limits accepted by the API: defaults and server-side maxima.
# APP_DEFAULT_RUN_MAX_STEPS=40
# APP_DEFAULT_RUN_MAX_TOOL_CALLS=12
# APP_DEFAULT_RUN_DEADLINE_SECONDS=120
# APP_MAX_RUN_MAX_STEPS=200
# APP_MAX_RUN_MAX_TOOL_CALLS=100
# APP_MAX_RUN_DEADLINE_SECONDS=900
# Optional LLM judge for rubric criteria and diagnosis suggestions (see docs/engineering/06).
# 'none' (default) keeps evaluation fully offline; rubric criteria are then inconclusive.
APP_JUDGE_PROVIDER=none
# Required only when APP_JUDGE_PROVIDER=groq. GROQ_API_KEY is also accepted. Never commit a key.
APP_GROQ_API_KEY=
APP_GROQ_MODEL=llama-3.3-70b-versatile
# APP_GROQ_BASE_URL=https://api.groq.com/openai/v1
# APP_JUDGE_TIMEOUT_SECONDS=30
# APP_JUDGE_SAMPLES=1

# --- Local PostgreSQL container (read by infra/docker-compose.yml) ------------
# POSTGRES_USER=reliabilitylab
# POSTGRES_PASSWORD=reliabilitylab_local_dev
# POSTGRES_DB=reliabilitylab
# POSTGRES_PORT=5433

# --- Frontend (copy to frontend/.env.local) ----------------------------------
# Backend base URL used by the dashboard's server-side API calls (never sent to the browser).
RELIABILITYLAB_API_URL=http://127.0.0.1:8000
# Opt out of Next.js anonymous telemetry if desired:
# NEXT_TELEMETRY_DISABLED=1
