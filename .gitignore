# Root-level ignores. frontend/ and backend/ have their own .gitignore files
# for toolchain-specific artifacts (node_modules, .next, .venv, caches).

# Environment files: never commit real values. .env.example is the template.
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
